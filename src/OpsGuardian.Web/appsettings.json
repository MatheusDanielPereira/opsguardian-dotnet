{
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "Enabled": true,
    "OutboxIntervalSeconds": 10,
    "SlaMonitorIntervalSeconds": 30
  },
  "Database": {
    "Provider": "SqlServer",
    "Initialize": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

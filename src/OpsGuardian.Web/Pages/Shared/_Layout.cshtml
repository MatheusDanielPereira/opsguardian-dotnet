<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="OpsGuardian incident and SLA operations dashboard." />
    <title>@ViewData["Title"] · OpsGuardian</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg" aria-label="Primary navigation">
            <div class="container app-container">
                <a class="navbar-brand" asp-page="/Index" aria-label="OpsGuardian dashboard">
                    <span class="brand-mark" aria-hidden="true">OG</span>
                    <span>OpsGuardian</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                        @if (User.IsInRole("IncidentManager"))
                        {
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-page="/Incidents/Create">New incident</a></li>
                        }
                        <li class="nav-item user-chip" aria-label="Signed-in user">@User.Identity?.Name</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container app-container page-shell" role="main">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success app-alert" role="status">@successMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container app-container footer-content">
            <span>OpsGuardian · resilient operations by design</span>
            <span>.NET 10 · SQL Server · OpenTelemetry</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

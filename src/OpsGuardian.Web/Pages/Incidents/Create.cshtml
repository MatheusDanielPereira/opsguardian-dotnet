@page
@model OpsGuardian.Web.Pages.Incidents.CreateModel
@{
    ViewData["Title"] = "Create incident";
}

<div class="page-heading">
    <div>
        <a class="back-link" asp-page="/Index">← Back to dashboard</a>
        <p class="eyebrow">Incident intake</p>
        <h1>Create a new incident</h1>
        <p>Capture enough context for the response team. The SLA deadline is calculated from severity.</p>
    </div>
</div>

<section class="form-panel">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>
        <div class="form-field">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control form-control-lg" autocomplete="off" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="form-grid">
            <div class="form-field">
                <label asp-for="Input.Severity" class="form-label"></label>
                <select asp-for="Input.Severity" asp-items="Html.GetEnumSelectList<IncidentSeverity>()" class="form-select"></select>
                <span asp-validation-for="Input.Severity" class="text-danger"></span>
            </div>
            <div class="form-field">
                <label asp-for="Input.AssignedEngineer" class="form-label"></label>
                <input asp-for="Input.AssignedEngineer" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.AssignedEngineer" class="text-danger"></span>
            </div>
        </div>
        <div class="form-field">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="7"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-page="/Index">Cancel</a>
            <button type="submit" class="btn btn-primary">Create and start SLA</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
